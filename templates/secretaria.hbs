<div class="aa-janela">
	<section class="aa-conteudo">
		<fieldset class="aa-cartao">
			<legend><i class="fa-solid fa-door-open"></i> Admissão</legend>
			{{#if temCandidatos}}
			<div class="aa-linha">
				<select name="aa-candidato">
					{{#each candidatos}}<option value="{{id}}">{{nome}}</option>{{/each}}
				</select>
				<button type="button" data-action="admitir"><i class="fa-solid fa-user-plus"></i> Admitir</button>
			</div>
			{{else}}
			<p class="aa-dica">Todos os personagens já estão registrados na Academia.</p>
			{{/if}}
		</fieldset>

		<fieldset class="aa-cartao">
			<legend><i class="fa-solid fa-calendar-days"></i> Período letivo (alunos ativos)</legend>
			<div class="aa-botoes">
				<button type="button" data-action="abrirMatriculas"><i class="fa-solid fa-file-circle-plus"></i> Abrir matrículas</button>
				<button type="button" data-action="iniciarTodos"><i class="fa-solid fa-play"></i> Iniciar semestre</button>
				<button type="button" data-action="encerrarTodos"><i class="fa-solid fa-flag-checkered"></i> Encerrar semestre</button>
				<button type="button" data-action="catalogo"><i class="fa-solid fa-book-open"></i> Catálogo de disciplinas</button>
				<button type="button" data-action="calendario"><i class="fa-solid fa-calendar-week"></i> Calendário</button>
				<button type="button" data-action="gerador"><i class="fa-solid fa-dice-d20"></i> Gerar alunos</button>
			</div>
		</fieldset>

		<fieldset class="aa-cartao">
			<legend><i class="fa-solid fa-users"></i> Corpo discente</legend>
			{{#if alunos.length}}
			<table class="aa-tabela-alunos">
				<thead>
					<tr><th></th><th>Aluno</th><th>Grêmio</th><th>Semestre</th><th>Disc.</th><th>Aprov.</th><th>Reprov.</th><th></th></tr>
				</thead>
				<tbody>
					{{#each alunos}}
					<tr data-actor="{{id}}" class="status-{{chave}}">
						<td><img src="{{img}}" alt="" class="aa-mini"></td>
						<td>{{nome}}{{#if npc}}<br><small>NPC · {{npc}}</small>{{/if}}</td>
						<td>{{#if gremio}}<span class="aa-etiqueta" style="--aa-cor: {{gremio.cor}}"><i class="{{gremio.icone}}"></i> {{gremio.apelido}}</span>{{else}}—{{/if}}</td>
						<td>{{semestre}}</td>
						<td>{{disciplinas}}</td>
						<td>{{aprovadas}}</td>
						<td>{{reprovadas}}</td>
						<td><button type="button" data-action="abrirAluno"><i class="fa-solid fa-folder-open"></i></button></td>
					</tr>
					{{/each}}
				</tbody>
			</table>
			{{else}}
			<p class="aa-dica">Nenhum aluno registrado.</p>
			{{/if}}
		</fieldset>
	</section>
</div>
