<div class="aa-painel-conteudo">
	<header class="aa-painel-topo" data-tooltip="Arraste para mover; clique duplo para voltar à posição padrão">
		{{#if plano}}<i class="{{plano.icone}}"></i>{{else}}<i class="fa-solid fa-building-columns"></i>{{/if}}
		<strong>{{#if plano}}{{plano.nome}}{{else}}{{#if academia.titulo}}{{academia.titulo}}{{else}}Na Academia{{/if}}{{/if}}</strong>
		{{#if plano}}<span class="aa-painel-rodada" data-tooltip="Parada do roteiro">{{plano.ordem}}/{{total}}</span>{{/if}}
		<span class="aa-painel-acoes">
			{{#if gm}}
			{{#if plano}}<a data-action="anterior" data-tooltip="{{#if plano.primeiro}}Voltar à Academia{{else}}Voltar ao plano anterior do roteiro{{/if}}"><i class="fa-solid fa-backward-step"></i></a>{{/if}}
			{{#unless plano.ultimo}}<a data-action="proximo" data-tooltip="{{#if plano}}Seguir para o próximo plano{{else}}Partir para o primeiro plano (Magika){{/if}}"><i class="fa-solid fa-forward-step"></i></a>{{/unless}}
			<a data-action="transicao" data-tooltip="Mostrar a todos o cartão de transição {{#if plano}}de {{plano.nome}}{{else}}da Academia{{/if}}"><i class="fa-solid fa-clapperboard"></i></a>
			<a data-action="editar" data-tooltip="{{#if plano}}Planos da expedição: escolher o plano e editar regras e anotações{{else}}Editar as anotações da Academia ou escolher um plano{{/if}}"><i class="fa-solid fa-pen-to-square"></i></a>
			{{/if}}
			{{#unless academia.vazia}}{{#unless minimizado}}<a data-action="recolher" data-tooltip="{{#if recolhido}}Mostrar regras e anotações{{else}}Mostrar só o título{{/if}}"><i class="fa-solid {{#if recolhido}}fa-chevron-down{{else}}fa-chevron-up{{/if}}"></i></a>{{/unless}}{{/unless}}
			<a data-action="minimizar" data-tooltip="{{#if minimizado}}Mostrar o painel{{else}}Minimizar o painel{{/if}}"><i class="fa-solid {{#if minimizado}}fa-window-maximize{{else}}fa-window-minimize{{/if}}"></i></a>
		</span>
	</header>
	{{#if plano}}
	<div class="aa-plano-corpo">
		<div class="aa-plano-faixa">
			<i class="aa-plano-emblema {{plano.icone}}"></i>
			<div>
				<span class="aa-plano-nome">{{plano.nome}}</span>
				<span class="aa-plano-deus">Mundo de {{plano.deus}} · {{plano.portfolio}}</span>
				<span class="aa-plano-ato">{{plano.rotuloAto}}</span>
			</div>
		</div>
		<div class="aa-plano-chips">
			<span data-tooltip="Nível sugerido do grupo ao chegar"><i class="fa-solid fa-user-graduate"></i> Nível {{plano.nivel}}</span>
			<span data-tooltip="CD de testes estendidos e desafios de perícia (18 + nível do plano)"><i class="fa-solid fa-bullseye"></i> CD {{plano.cd}}</span>
			<span data-tooltip="Perigo do mundo"><i class="fa-solid fa-triangle-exclamation"></i> {{plano.perigo}}</span>
			{{#if gm}}{{#if plano.sobe}}<span data-tooltip="O grupo sobe de nível ao concluir este plano (só o mestre vê)"><i class="fa-solid fa-arrow-up"></i> Sobe ao sair</span>{{/if}}{{/if}}
		</div>
		<section class="aa-plano-regra">
			<h3><i class="fa-solid fa-scroll"></i> {{plano.regraTitulo}}</h3>
			<ul class="aa-painel-detalhe">
				{{#each plano.regras}}<li>{{{this}}}</li>{{else}}<li class="aa-painel-vazio">Sem regras anotadas.</li>{{/each}}
			</ul>
		</section>
		{{#if plano.anotacoes.length}}
		<section class="aa-plano-notas aa-painel-detalhe">
			<h3><i class="fa-solid fa-feather-pointed"></i> Anotações</h3>
			{{#each plano.anotacoes}}<p>{{{this}}}</p>{{/each}}
		</section>
		{{/if}}
		{{#if plano.segredo.length}}
		<section class="aa-plano-notas aa-plano-segredo aa-painel-detalhe">
			<h3><i class="fa-solid fa-eye-slash"></i> Só o mestre vê</h3>
			{{#each plano.segredo}}<p>{{{this}}}</p>{{/each}}
		</section>
		{{/if}}
	</div>
	{{#if gm}}
	<footer class="aa-painel-rodape">
		<span>{{#if plano.editado}}<i class="fa-solid fa-pen"></i> Regras editadas{{else}}Regras da Wiki Divina{{/if}}</span>
	</footer>
	<footer class="aa-painel-rodape aa-plano-teste">
		<span><i class="fa-solid fa-dice-d20"></i> {{#if teste.definido}}{{teste.titulo}} <small>{{teste.sucessos}}/{{teste.sucessosNecessarios}} · {{teste.falhas}}/{{teste.falhasLimite}}</small>{{else}}Teste estendido{{/if}}</span>
		<span class="aa-painel-acoes">
			<a data-action="testeVisivel" class="{{#if teste.visivel}}ativo{{/if}}" data-tooltip="{{#if teste.visivel}}Esconder o painel do teste estendido{{else}}{{#if teste.definido}}Mostrar o painel do teste estendido a todos{{else}}Montar um teste estendido{{/if}}{{/if}}"><i class="fa-solid {{#if teste.visivel}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>
			<a data-action="testeEditar" data-tooltip="Editar o teste estendido"><i class="fa-solid fa-pen-to-square"></i></a>
		</span>
	</footer>
	{{/if}}
	{{else}}
	<div class="aa-plano-corpo">
		<div class="aa-plano-faixa">
			<i class="aa-plano-emblema {{academia.icone}}"></i>
			<div>
				<span class="aa-plano-nome">{{#if academia.titulo}}{{academia.titulo}}{{else}}Na Academia{{/if}}</span>
				<span class="aa-plano-deus">{{academia.nome}}</span>
			</div>
		</div>
		{{#if academia.anotacoes.length}}
		<section class="aa-plano-notas aa-painel-detalhe">
			<h3><i class="fa-solid fa-feather-pointed"></i> Anotações</h3>
			{{#each academia.anotacoes}}<p>{{{this}}}</p>{{/each}}
		</section>
		{{/if}}
		{{#if academia.segredo.length}}
		<section class="aa-plano-notas aa-plano-segredo aa-painel-detalhe">
			<h3><i class="fa-solid fa-eye-slash"></i> Só o mestre vê</h3>
			{{#each academia.segredo}}<p>{{{this}}}</p>{{/each}}
		</section>
		{{/if}}
		{{#if academia.vazia}}
		<section>
			<p class="aa-painel-vazio">A turma está na Academia. Use <i class="fa-solid fa-pen-to-square"></i> para anotar uma cena ou evento (os jogadores veem o painel quando houver anotações) ou <i class="fa-solid fa-forward-step"></i> para partir para Magika.</p>
		</section>
		{{/if}}
	</div>
	{{#if gm}}
	<footer class="aa-painel-rodape aa-plano-teste">
		<span><i class="fa-solid fa-dice-d20"></i> {{#if teste.definido}}{{teste.titulo}} <small>{{teste.sucessos}}/{{teste.sucessosNecessarios}} · {{teste.falhas}}/{{teste.falhasLimite}}</small>{{else}}Teste estendido{{/if}}</span>
		<span class="aa-painel-acoes">
			<a data-action="testeVisivel" class="{{#if teste.visivel}}ativo{{/if}}" data-tooltip="{{#if teste.visivel}}Esconder o painel do teste estendido{{else}}{{#if teste.definido}}Mostrar o painel do teste estendido a todos{{else}}Montar um teste estendido{{/if}}{{/if}}"><i class="fa-solid {{#if teste.visivel}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>
			<a data-action="testeEditar" data-tooltip="Editar o teste estendido"><i class="fa-solid fa-pen-to-square"></i></a>
		</span>
	</footer>
	{{/if}}
	{{/if}}
</div>
